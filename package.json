{
  "name": "codexbridge-distribution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "bundle": "node scripts/configure.mjs",
    "doctor": "node scripts/doctor.mjs",
    "companion:build": "node scripts/build-companion.mjs",
    "smoke:codex": "node scripts/smoke-codex.mjs",
    "start": "node scripts/launch.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:lsp": "node scripts/smoke-lsp.mjs",
    "smoke:opencode": "node scripts/smoke-opencode.mjs",
    "smoke:inference": "node scripts/smoke-inference.mjs",
    "bundle:all": "node scripts/configure.mjs companions && node scripts/configure.mjs jarvis && node scripts/configure.mjs quiet",
    "setup:snip": "node scripts/install-snip.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@plannotator/opencode": "0.27.24",
    "@shantur/jarvis-mcp": "1.0.1",
    "opencode-smart-voice-notify": "1.4.0",
    "opencode-snip": "2.0.0",
    "typescript-language-server": "4.3.4"
  }
}
