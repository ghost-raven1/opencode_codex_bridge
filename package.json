{
  "name": "codexbridge-distribution",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run --configLoader runner",
    "check": "npm run typecheck && npm test && npm run build",
    "bundle": "node scripts/configure.mjs",
    "doctor": "node scripts/doctor.mjs",
    "companion:build": "node scripts/build-companion.mjs",
    "setup:tts": "node scripts/setup-local-tts.mjs",
    "setup:playwright": "node scripts/setup-playwright.mjs",
    "smoke:voice": "node scripts/smoke-local-voice.mjs",
    "smoke:dictation": "node scripts/smoke-dictation.mjs",
    "smoke:voice-wake": "node scripts/smoke-wake-word.mjs",
    "smoke:codex": "node scripts/smoke-codex.mjs",
    "start": "node scripts/launch.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:lsp": "node scripts/smoke-lsp.mjs",
    "smoke:opencode": "node scripts/smoke-opencode.mjs",
    "smoke:inference": "node scripts/smoke-inference.mjs",
    "connect:codex": "node scripts/connect-codex.mjs",
    "smoke:provider": "node scripts/smoke-opencode.mjs --inference",
    "bundle:all": "node scripts/configure.mjs companions && node scripts/configure.mjs jarvis && node scripts/configure.mjs quiet",
    "setup:snip": "node scripts/install-snip.mjs",
    "smoke:companions": "node scripts/smoke-companions.mjs",
    "test:native": "node scripts/test-native.mjs",
    "qa:motion": "node scripts/qa-companion-motion.mjs",
    "assets:choreography": "node scripts/prepare-choreography.mjs",
    "qa:choreography": "node scripts/qa-choreography.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@plannotator/opencode": "0.27.24",
    "@playwright/mcp": "0.0.83",
    "@shantur/jarvis-mcp": "1.0.1",
    "opencode-smart-voice-notify": "1.4.0",
    "opencode-snip": "2.0.0",
    "typescript-language-server": "4.3.4"
  }
}
